{
  "expo": {
    "name": "SafePath AI",
    "slug": "safepath-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.safepathai.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "entryPoint": "./App.tsx",
    "plugins": [
      "expo-asset"
    ]
  }
}
