{
  "expo": {
    "name": "SafePath AI",
    "slug": "safepath-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.safepathai.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "entryPoint": "./App.tsx",
    "plugins": [
      "expo-asset",
      ["expo-image-picker", { "cameraPermission": "SafePath AI uses the camera to capture road hazard reports." }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "SafePath AI uses your location to place hazard reports and calculate routes." }]
    ]
  }
}
